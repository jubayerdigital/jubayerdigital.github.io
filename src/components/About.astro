---
interface Props {
  data: {
    heading: string;
    body: string;
    photo?: string;
    signatureLine?: string;
  };
}
const { data } = Astro.props;
---

<section class="about section section--alt" id="about">
  <div class="wrap about__grid">
    <div class="about__photo reveal">
      <img src={data.photo || '/images/about-placeholder.svg'} alt="Portrait" width="480" height="560" loading="lazy" />
    </div>
    <div class="about__copy reveal">
      <p class="eyebrow">About</p>
      <h2>{data.heading}</h2>
      <p class="about__body">{data.body}</p>
      {data.signatureLine && <p class="about__signature numeral">{data.signatureLine}</p>}
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .about__photo img {
    width: 100%;
    aspect-ratio: 4 / 4.6;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--paper-deep);
  }

  .about__copy {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 52ch;
  }

  .about__body {
    color: var(--ink-soft);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .about__signature {
    font-size: 1.15rem;
    margin-top: 0.5rem;
  }

  @media (min-width: 780px) {
    .about__grid {
      grid-template-columns: 0.85fr 1.15fr;
    }
  }
</style>
