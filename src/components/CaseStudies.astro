---
interface CaseStudy {
  client: string;
  problem: string;
  approach: string;
  result: string;
  statNumber: string;
  statLabel: string;
}
interface Props {
  studies: CaseStudy[];
}
const { studies } = Astro.props;
---

<section class="case-studies section section--alt" id="work">
  <div class="wrap">
    <p class="eyebrow reveal">Case studies</p>
    <h2 class="reveal">Recent work, plainly stated</h2>
  </div>

  <div class="case-studies__list">
    {studies.map((study) => (
      <article class="case-study reveal">
        <div class="wrap case-study__grid">
          <div class="case-study__copy">
            <h3 class="case-study__client">{study.client}</h3>
            <dl class="case-study__stages">
              <div>
                <dt>Problem</dt>
                <dd>{study.problem}</dd>
              </div>
              <div>
                <dt>Approach</dt>
                <dd>{study.approach}</dd>
              </div>
              <div>
                <dt>Result</dt>
                <dd>{study.result}</dd>
              </div>
            </dl>
          </div>
          <div class="case-study__stat">
            <span class="numeral case-study__stat-number">{study.statNumber}</span>
            <span class="case-study__stat-label">{study.statLabel}</span>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .case-studies > .wrap {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .case-studies__list {
    display: flex;
    flex-direction: column;
  }

  .case-study {
    border-top: 1px solid var(--line);
    padding-block: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .case-study:last-child {
    border-bottom: 1px solid var(--line);
  }

  .case-study__grid {
    display: grid;
    gap: 2.5rem;
  }

  .case-study__client {
    margin-bottom: 1.5rem;
  }

  .case-study__stages {
    display: grid;
    gap: 1.25rem;
    margin: 0;
  }

  .case-study__stages dt {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 0.3rem;
  }

  .case-study__stages dd {
    margin: 0;
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.6;
    max-width: 58ch;
  }

  .case-study__stat {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    justify-content: center;
  }

  .case-study__stat-number {
    font-size: clamp(3rem, 2.4rem + 3vw, 4.5rem);
    line-height: 1;
  }

  .case-study__stat-label {
    font-size: 0.9rem;
    color: var(--ink-soft);
    max-width: 22ch;
  }

  @media (min-width: 780px) {
    .case-study__grid {
      grid-template-columns: 1.5fr 1fr;
    }
    .case-study__stat {
      border-left: 1px solid var(--line);
      padding-left: 2.5rem;
    }
  }
</style>
