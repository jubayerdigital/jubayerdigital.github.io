---
interface Service {
  title: string;
  outcome: string;
}
interface Props {
  services: Service[];
}
const { services } = Astro.props;
---

<section class="services section section--alt" id="services">
  <div class="wrap">
    <p class="eyebrow reveal">Services</p>
    <h2 class="reveal">Three ways to work together</h2>

    <div class="services__grid">
      {services.map((service, i) => (
        <article class="services__card reveal">
          <span class="numeral services__index">{String(i + 1).padStart(2, '0')}</span>
          <h3>{service.title}</h3>
          <p>{service.outcome}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services > .wrap > .eyebrow {
    margin-bottom: 0.75rem;
  }

  .services > .wrap > h2 {
    margin-bottom: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .services__grid {
    display: grid;
    gap: 1.5rem;
  }

  .services__card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 2.25rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .services__index {
    font-size: 1.4rem;
  }

  .services__card p {
    color: var(--ink-soft);
  }

  @media (min-width: 860px) {
    .services__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
