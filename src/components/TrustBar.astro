---
interface Props {
  data: {
    label: string;
    items: { name: string }[];
  };
}
const { data } = Astro.props;
---

<section class="trustbar">
  <div class="wrap trustbar__row">
    <p class="trustbar__label">{data.label}</p>
    <ul class="trustbar__list">
      {data.items.map((item) => (
        <li>{item.name}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .trustbar {
    padding-block: 1.75rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .trustbar__row {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .trustbar__label {
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .trustbar__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem;
  }

  .trustbar__list li {
    font-size: 0.85rem;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  @media (min-width: 700px) {
    .trustbar__row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
