---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Md Jubayer Hossain | Digital Marketing Specialist",
  description = "Digital marketing specialist helping businesses grow with SEO, Google Ads, Meta Ads and strategic marketing."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Inter:wght@300;400;500;600;700&display=swap"
  rel="stylesheet">

</head>

<body>

  <slot />

</body>
</html>
