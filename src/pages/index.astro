---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>

<section class="hero">

    <div class="container">

        <p class="eyebrow">
            Digital Marketing Specialist
        </p>

        <h1>
            Marketing that pays for itself —
            not just looks good.
        </h1>

        <p class="lead">
            I work with a small number of clients at a time—
            so every campaign gets senior-level attention,
            not leftover bandwidth.
        </p>

        <a href="#contact" class="button">
            Apply for a Strategy Call
        </a>

    </div>

</section>

</BaseLayout>

<style>

.hero{

min-height:100vh;

display:flex;

align-items:center;

}

.eyebrow{

color:var(--accent);

font-weight:600;

margin-bottom:18px;

letter-spacing:.08em;

text-transform:uppercase;

font-size:.9rem;

}

h1{

font-size:clamp(3rem,7vw,4.8rem);

max-width:800px;

margin-bottom:30px;

}

.lead{

max-width:650px;

font-size:1.2rem;

color:var(--muted);

margin-bottom:42px;

}

.button{

display:inline-block;

padding:16px 32px;

background:var(--accent);

color:white;

border-radius:999px;

font-weight:600;

transition:.25s;

}

.button:hover{

transform:translateY(-2px);

}

</style>
